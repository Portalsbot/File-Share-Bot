# Required runtime configuration
BOT_TOKEN=123456:replace_me
OWNER_ID=123456789
ADMINS=
CLONE_ID=official
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional public channel shown by the Start, About and Help screens.
# Leave empty to omit the Channel button until a real destination is configured.
CHANNEL_URL=

# Telegram fetches this direct image URL for every bot-authored text reply.
# Correct default branding image URL.
BRANDING_IMAGE_URL=https://i.ibb.co/PGpMYwYY/Gemini-Generated-Image-a7tjlia7tjlia7tj.png
# Optional: mount a local JPEG and set BRANDING_IMAGE_PATH=/app/assets/branding.jpg
BRANDING_IMAGE_PATH=
SMALL_CAPS=true

# Central file storage channel; the bot must be able to read/copy messages from it.
STORAGE_CHANNEL_ID=
DEFAULT_AUTO_DELETE=0
MAX_FILES_PER_USER=50
