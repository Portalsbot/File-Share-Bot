# Required runtime configuration
BOT_TOKEN=123456:replace_me
OWNER_ID=123456789
ADMINS=
CLONE_ID=official
DATABASE_URL=postgresql://user:password@host:5432/database

# Telegram fetches this direct image URL for every bot-authored text reply.
# Original user link: https://github.com/Portalsbot/image/blob/main/photo_2026-11-01_20-42-48.jpg
BRANDING_IMAGE_URL=https://raw.githubusercontent.com/Portalsbot/image/main/photo_2026-11-01_20-42-48.jpg
# Optional: mount a local JPEG and set BRANDING_IMAGE_PATH=/app/assets/branding.jpg
BRANDING_IMAGE_PATH=
SMALL_CAPS=true

# File Sharing settings (unused by Link Sharing)
STORAGE_CHANNEL_ID=-1001234567890
DEFAULT_AUTO_DELETE=0
MAX_FILES_PER_USER=50
